# DeepScan Backend Environment Variables
# Copy your Groq API key here (get one at https://console.groq.com/keys)
GROQ_API_KEY=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


# LLM Provider: "groq" (cloud) or "ollama" (local)
LLM_PROVIDER=groq

# Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama settings (only needed if using local Ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Database (optional - defaults to SQLite if not set)
# DATABASE_URL=postgresql://user:password@host:port/dbname
